@charset "utf-8";

body { background-color: rgb(255, 255, 255); margin: 0px; }

body, .text, pre { font-family: "Source Sans Pro", Arial, Helvetica, sans-serif; color: rgb(52, 52, 52); font-size: 14px; line-height: 1.428; }

#Body.body-is-liquid { width: auto; }

