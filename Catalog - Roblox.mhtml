.account-recovery-modal-title-container { position: relative; height: 28px; }

.account-recovery-modal-body-text { margin: 12px 0px; padding-bottom: 24px; }

.account-recovery-no-button-container, .account-recovery-yes-button-container { margin: 12px 0px; }

